# Copy to Railway → Service → Variables. Nothing here is required for the service to start.
# cTrader Open API (preferred, D-69): openapi.ctrader.com → your app → Credentials (id + secret) and
# Playground → scope "trading" → Get token (access + refresh). Account id: the ctidTraderAccountId or the account
# number shown in cTrader. When these are complete, CTRADER_MCP_CONFIG is ignored.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCES_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
# fallback: cTrader Web → Settings → Remote MCP → "Copy configuration" → paste the WHOLE block here
CTRADER_MCP_CONFIG=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# paper = decisions + simulated fills (default); live = real orders
TRADING_MODE=paper
# must be YES when the token belongs to a LIVE account
CONFIRM_LIVE_ACCOUNT=NO
SYMBOLS=XAUUSD,BTCUSD
# the owner's lot size; a symbol without a lot never trades
LOT_XAUUSD=0.10
LOT_BTCUSD=0.01
MAX_LOT=1.0
MAX_OPEN_TOTAL=2
MAX_OPEN_PER_SYMBOL=1
MAX_TRADES_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=3
DAILY_LOSS_LIMIT_R=3.0
TP1_CLOSE_PCT=50
NOTIFY_EXITS=false
# JSON overrides (defaults shown)
# CONTRACT_SIZE={"XAUUSD":100,"BTCUSD":1}
# MAX_SPREAD={"XAUUSD":0.80,"BTCUSD":60}
# MAX_SLIPPAGE_POINTS={"XAUUSD":300,"BTCUSD":3000}
# SL_SAFETY_BUFFER={"XAUUSD":0.30,"BTCUSD":15}
# PRICE_DIGITS={"XAUUSD":3,"BTCUSD":2}
# PRICE_BANDS={"XAUUSD":[1500,14000],"BTCUSD":[25000,240000]}
# intraday = chains price can reach this session first (default); strict = GEM1 gates only
# CHAIN_MODE=intraday
# MAPPER_MIN_CHAIN_LPS=65,50,40
# MAP_MAX_AGE_H=6
# DATA_DIR=/data
LOG_LEVEL=INFO
